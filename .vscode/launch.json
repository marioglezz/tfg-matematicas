{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug NGCF",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/src/NGCF/NGCF.py",
            "args": [
                "--dataset", "movielens_1M",
                "--regs", "[1e-5]",
                "--embed_size", "16",
                "--layer_size", "[16,16,16]",
                "--lr", "0.0005",
                "--batch_size", "1024",
                "--epoch", "200",
                "--verbose", "50",
                "--node_dropout", "[0.1]",
                "--mess_dropout", "[0.1,0.1,0.1]"
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "TF_CPP_MIN_LOG_LEVEL": "2" 
            }
        },
        {
            "name": "Debug MF",
